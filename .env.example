# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowguard?currentSchema=metadata
SPRING_DATASOURCE_USERNAME=flowguard
SPRING_DATASOURCE_PASSWORD=flowguard
DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowguard?currentSchema=fixture

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Orchestrator API key (optional; when set, clients must send X-API-Key)
FLOWGUARD_API_KEY=

# OAuth (prod overlay enables introspection on backend + gateway)
FLOWGUARD_OAUTH_ENABLED=false
FLOWGUARD_PRODUCTION_GUARDS=false
AUTH_INTROSPECT_URL=http://localhost:9000/oauth2/introspect
AUTH_CLIENT_ID=flowguard-gateway
AUTH_CLIENT_SECRET=flowguard-gateway-secret
AUTH_UI_CLIENT_ID=flowguard-ui
AUTH_UI_CLIENT_SECRET=flowguard-ui-secret

# Internal service tokens (required when FLOWGUARD_PRODUCTION_GUARDS=true)
FIXTURE_INTERNAL_TOKEN=
GATEWAY_INTERNAL_TOKEN=
FLOWGUARD_API_GATEWAY_URL=http://localhost:8088

# Meta Model API (backend only — never commit real keys)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3

# Fixture variant: dup-credit-vulnerable | debit-race-vulnerable
FIXTURE_VARIANT=dup-credit-vulnerable
FIXTURE_MESSAGING_ENABLED=true
FIXTURE_REDIS_IDEMPOTENCY_ENABLED=true
FIXTURE_TRANSACTIONS_TOPIC=flowguard.transactions
FIXTURE_SAGA_EVENTS_TOPIC=flowguard.saga.events
FIXTURE_STALE_SAGA_MINUTES=5
FIXTURE_SAGA_OUTBOX_POLL_MS=500
FIXTURE_TRANSACTION_OUTBOX_POLL_MS=500
FIXTURE_MAX_OUTBOX_PUBLISH_ATTEMPTS=5

# Production-like stack (reference-safe fixture + OAuth + guards):
# Copy to .env and set strong secrets (16+ chars for GATEWAY_INTERNAL_TOKEN):
#   FLOWGUARD_API_KEY=...
#   GATEWAY_INTERNAL_TOKEN=...
#   FIXTURE_INTERNAL_TOKEN=...
# docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# .\scripts\smoke-gateway-live.ps1
# Frontend: npm run dev (proxy -> :8088); sign in at /login as ops for /ops and /dashboard

# Monitoring (when prometheus/grafana services are up)
# PROMETHEUS_URL=http://localhost:9090
# GRAFANA_URL=http://localhost:3000

# Python evidence processor
EVIDENCE_PROCESSOR_URL=http://localhost:8090
